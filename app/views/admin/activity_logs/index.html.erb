<h1 class="text-4xl">Aktivitätsprotokoll</h1>
<div class="mt-3 h-0.5 w-12 bg-brand-500"></div>

<%= form_with url: admin_activity_logs_path, method: :get,
      class: "ka-card mt-8 flex flex-wrap items-end gap-4 p-5" do %>
  <div>
    <label class="ka-label normal-case tracking-normal">Aktion</label>
    <%= select_tag :action_filter,
          options_for_select(@actions, params[:action_filter]),
          include_blank: "Alle Aktionen", class: "ka-input min-w-48" %>
  </div>

  <div>
    <label class="ka-label normal-case tracking-normal">Benutzer</label>
    <%= select_tag :user_id,
          options_from_collection_for_select(@users, :id, :email_address, params[:user_id]),
          include_blank: "Alle Benutzer", class: "ka-input min-w-56" %>
  </div>

  <%= submit_tag "Filtern", class: "ka-btn-primary text-sm" %>
  <%= link_to "Zurücksetzen", admin_activity_logs_path, class: "ka-label transition hover:text-white" %>
<% end %>

<div class="ka-card mt-6 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="ka-table">
      <thead>
        <tr>
          <th>Zeitpunkt</th>
          <th>Benutzer</th>
          <th>Aktion</th>
          <th>Objekt</th>
          <th>Details</th>
          <th>IP</th>
        </tr>
      </thead>
      <tbody>
        <% if @logs.empty? %>
          <tr><td colspan="6" class="py-10 text-center text-slate-500">Keine Einträge gefunden.</td></tr>
        <% end %>

        <% @logs.each do |log| %>
          <tr class="transition hover:bg-white/[0.02]">
            <td class="whitespace-nowrap font-mono text-xs text-slate-500">
              <%= log.created_at.strftime("%d.%m.%Y %H:%M:%S") %>
            </td>
            <td class="font-mono text-xs text-slate-400"><%= log.actor_name %></td>
            <td>
              <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 font-mono text-xs text-slate-300">
                <%= log.action %>
              </span>
            </td>
            <td class="font-mono text-xs text-slate-500"><%= log.target_label %></td>
            <td class="text-xs text-slate-400"><%= log.description %></td>
            <td class="font-mono text-xs text-slate-600"><%= log.ip_address %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<p class="ka-label mt-4">Es werden maximal die 200 neuesten Einträge angezeigt.</p>
