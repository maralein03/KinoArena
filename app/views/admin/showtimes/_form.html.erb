<%= render "shared/errors", record: showtime %>

<%= form_with model: showtime, url: url, method: method, class: "space-y-4" do |f| %>
  <%# NFA-2: lock_version wird mitgesendet und von Rails geprueft %>
  <%= f.hidden_field :lock_version %>

  <div>
    <%= f.label :movie_id, "Film", class: "ka-label normal-case tracking-normal" %>
    <%= f.collection_select :movie_id, @movies, :id, :title, { include_blank: "Bitte wählen" }, class: "ka-input" %>
  </div>

  <div>
    <%= f.label :auditorium_id, "Saal", class: "ka-label normal-case tracking-normal" %>
    <%= f.collection_select :auditorium_id, @auditoria, :id, :name, { include_blank: "Bitte wählen" }, class: "ka-input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :start_time, "Beginn", class: "ka-label normal-case tracking-normal" %>
      <%= f.datetime_field :start_time, class: "ka-input" %>
    </div>

    <div>
      <%= f.label :price, "Preis (CHF)", class: "ka-label normal-case tracking-normal" %>
      <%= f.number_field :price, step: 0.05, class: "ka-input" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit submit_label, class: "ka-btn-primary" %>
    <%= link_to "Abbrechen", admin_showtimes_path, class: "ka-btn-ghost" %>
  </div>
<% end %>
