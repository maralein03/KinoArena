<%= render "shared/errors", record: movie %>

<%= form_with model: movie, url: url, method: method, class: "space-y-4" do |f| %>
  <%# NFA-2: lock_version wird mitgesendet und von Rails geprueft %>
  <%= f.hidden_field :lock_version %>

  <div>
    <%= f.label :title, "Titel", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 w-full rounded border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :description, "Beschreibung", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 4, class: "mt-1 w-full rounded border-gray-300 shadow-sm" %>
  </div>

  <div>
    <%= f.label :duration_minutes, "Dauer (Minuten)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :duration_minutes, class: "mt-1 w-full rounded border-gray-300 shadow-sm" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit submit_label, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded cursor-pointer" %>
    <%= link_to "Abbrechen", admin_movies_path, class: "px-4 py-2 rounded border border-gray-300 text-gray-700" %>
  </div>
<% end %>
