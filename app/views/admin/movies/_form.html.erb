<%= render "shared/errors", record: movie %>

<%= form_with model: movie, url: url, method: method, class: "space-y-4" do |f| %>
  <%# NFA-2: lock_version wird mitgesendet und von Rails geprueft %>
  <%= f.hidden_field :lock_version %>

  <div>
    <%= f.label :title, "Titel", class: "ka-label normal-case tracking-normal" %>
    <%= f.text_field :title, class: "ka-input" %>
  </div>

  <div>
    <%= f.label :description, "Beschreibung", class: "ka-label normal-case tracking-normal" %>
    <%= f.text_area :description, rows: 4, class: "ka-input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :duration_minutes, "Dauer (Minuten)", class: "ka-label normal-case tracking-normal" %>
      <%= f.number_field :duration_minutes, class: "ka-input" %>
    </div>

    <div>
      <%= f.label :poster_url, "Poster-URL", class: "ka-label normal-case tracking-normal" %>
      <%= f.url_field :poster_url, placeholder: "https://…", class: "ka-input" %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit submit_label, class: "ka-btn-primary" %>
    <%= link_to "Abbrechen", admin_movies_path, class: "ka-btn-ghost" %>
  </div>
<% end %>
