<% if record.errors.any? %>
  <div class="mb-5 rounded-lg border border-brand-500/40 bg-brand-500/10 px-4 py-3 text-sm text-brand-300">
    <p class="mb-1 font-medium">Bitte korrigiere folgende Angaben:</p>
    <ul class="list-inside list-disc space-y-0.5 text-brand-300/90">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
