<h1 class="text-4xl">Benutzerverwaltung</h1>
<div class="mt-3 h-0.5 w-12 bg-brand-500"></div>

<div class="ka-card mt-8 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="ka-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>E-Mail</th>
          <th>Rolle</th>
          <th>Tickets</th>
          <th>Registriert</th>
          <th class="text-right">Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="transition hover:bg-white/[0.02]">
            <td><%= link_to user.name, user_path(user), class: "text-white transition hover:text-brand-400" %></td>
            <td class="font-mono text-xs text-slate-400"><%= user.email_address %></td>
            <td>
              <% if user.admin? %>
                <span class="ka-chip">Administrator</span>
              <% else %>
                <span class="rounded-md border border-white/10 px-2 py-0.5 font-mono text-xs text-slate-400">Kunde</span>
              <% end %>
            </td>
            <td class="text-slate-400"><%= user.bookings.count %></td>
            <td class="text-slate-500"><%= l user.created_at.to_date %></td>
            <td>
              <div class="flex justify-end gap-3 text-xs">
                <%= link_to "Bearbeiten", edit_user_path(user), class: "text-slate-400 underline transition hover:text-white" %>
                <% if policy(user).destroy? %>
                  <%= button_to "Löschen", user_path(user), method: :delete,
                        form: { data: { turbo_confirm: "Konto #{user.email_address} wirklich löschen?" } },
                        class: "text-brand-400 underline transition hover:text-brand-300" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
