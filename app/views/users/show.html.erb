<div class="mx-auto max-w-3xl">
  <div class="ka-card p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-500/15 font-display text-xl text-brand-400">
          <%= @user.name.to_s.first&.upcase %>
        </span>
        <div>
          <h1 class="text-2xl"><%= @user.name %></h1>
          <p class="mt-0.5 font-mono text-sm text-slate-400"><%= @user.email_address %></p>
          <span class="ka-chip mt-2"><%= @user.role_name %></span>
        </div>
      </div>

      <div class="flex gap-2">
        <% if policy(@user).update? %>
          <%= link_to "Bearbeiten", edit_user_path(@user), class: "ka-btn-ghost text-sm" %>
        <% end %>
        <% if policy(@user).destroy? %>
          <%= button_to "Konto löschen", user_path(@user), method: :delete,
                form: { data: { turbo_confirm: "Konto wirklich unwiderruflich löschen?" } },
                class: "rounded-lg border border-brand-500/40 px-4 py-2.5 text-sm text-brand-400 transition hover:bg-brand-500/10" %>
        <% end %>
      </div>
    </div>

    <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-white/5 pt-6 text-sm">
      <div>
        <dt class="ka-label">Registriert seit</dt>
        <dd class="mt-1 text-slate-200"><%= l @user.created_at.to_date %></dd>
      </div>
      <div>
        <dt class="ka-label">Gebuchte Tickets</dt>
        <dd class="mt-1 text-slate-200"><%= @bookings.size %></dd>
      </div>
    </dl>
  </div>

  <div class="ka-card mt-6 p-8">
    <h2 class="text-xl">Buchungen</h2>
    <div class="mt-2 h-0.5 w-12 bg-brand-500"></div>

    <% if @bookings.empty? %>
      <p class="mt-5 text-sm text-slate-500">Noch keine Buchungen vorhanden.</p>
    <% else %>
      <ul class="mt-5 divide-y divide-white/5">
        <% @bookings.each do |booking| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
            <span class="text-slate-300">
              <strong class="text-white"><%= booking.showtime.movie.title %></strong>
              <span class="text-slate-500">
                &middot; <%= showtime_date(booking.showtime.start_time) %>
                <%= booking.showtime.start_time.strftime("%H:%M") %>
                &middot; <%= booking.showtime.auditorium.name %>
              </span>
            </span>
            <span class="flex items-center gap-3">
              <span class="ka-chip"><%= booking.seat.label %></span>
              <span class="font-mono text-xs text-slate-400"><%= chf(booking.total_price) %></span>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
