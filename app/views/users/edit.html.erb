<div class="mx-auto max-w-md">
  <div class="ka-card p-8">
    <h1 class="text-2xl">Profil bearbeiten</h1>
    <div class="mt-2 mb-6 h-0.5 w-12 bg-brand-500"></div>

    <%= render "shared/errors", record: @user %>

    <%= form_with model: @user, url: user_path(@user), method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, "Name", class: "ka-label normal-case tracking-normal" %>
        <%= f.text_field :name, class: "ka-input" %>
      </div>

      <div>
        <%= f.label :email_address, "E-Mail", class: "ka-label normal-case tracking-normal" %>
        <%= f.email_field :email_address, class: "ka-input" %>
      </div>

      <div class="border-t border-white/5 pt-5">
        <p class="text-xs text-slate-500">Passwort nur ausfüllen, wenn du es ändern möchtest.</p>

        <div class="mt-3">
          <%= f.label :password, "Neues Passwort", class: "ka-label normal-case tracking-normal" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "ka-input" %>
        </div>

        <div class="mt-3">
          <%= f.label :password_confirmation, "Wiederholen", class: "ka-label normal-case tracking-normal" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "ka-input" %>
        </div>
      </div>

      <% if policy(@user).change_role? %>
        <label class="flex items-center gap-2.5 border-t border-white/5 pt-5 text-sm text-slate-300">
          <%= f.check_box :admin, class: "h-4 w-4 rounded border-white/20 bg-ink-700 text-brand-500 focus:ring-brand-500" %>
          Administratorrechte vergeben
        </label>
      <% end %>

      <div class="flex gap-3 pt-2">
        <%= f.submit "Speichern", class: "ka-btn-primary flex-1" %>
        <%= link_to "Abbrechen", user_path(@user), class: "ka-btn-ghost flex-1" %>
      </div>
    <% end %>
  </div>
</div>
