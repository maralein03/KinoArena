<div class="mx-auto max-w-3xl">
  <h1 class="text-4xl">Meine Tickets</h1>
  <div class="mt-3 h-0.5 w-12 bg-brand-500"></div>

  <p class="ka-label mt-6"><%= pluralize(@bookings.size, "Buchung", plural: "Buchungen") %></p>

  <% if @bookings.empty? %>
    <div class="ka-card mt-6 p-12 text-center">
      <p class="text-slate-400">Du hast noch keine Tickets gebucht.</p>
      <%= link_to "Zum Programm", root_path, class: "ka-btn-primary mt-6" %>
    </div>
  <% else %>
    <div class="mt-6 space-y-4">
      <% @bookings.each do |booking| %>
        <% showtime = booking.showtime %>
        <div class="ka-card flex gap-5 overflow-hidden">
          <div class="w-24 shrink-0 bg-ink-700">
            <% if showtime.movie.poster_url.present? %>
              <%= image_tag showtime.movie.poster_url, alt: showtime.movie.title, loading: "lazy",
                    class: "h-full w-full object-cover" %>
            <% end %>
          </div>

          <div class="flex-1 py-5 pr-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-xl"><%= showtime.movie.title %></h2>
                <p class="ka-label mt-1"><%= booking_reference(booking) %></p>
              </div>

              <% if showtime.start_time.future? %>
                <span class="ka-chip">Bevorstehend</span>
              <% else %>
                <span class="rounded-md border border-white/10 px-2 py-0.5 font-mono text-xs text-slate-500">Vergangen</span>
              <% end %>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
              <div>
                <dt class="ka-label">Datum</dt>
                <dd class="mt-0.5 text-slate-200"><%= showtime_date(showtime.start_time) %></dd>
              </div>
              <div>
                <dt class="ka-label">Zeit</dt>
                <dd class="mt-0.5 font-mono text-gold-400"><%= showtime.start_time.strftime("%H:%M") %></dd>
              </div>
              <div>
                <dt class="ka-label">Saal</dt>
                <dd class="mt-0.5 text-slate-200"><%= showtime.auditorium.name %></dd>
              </div>
              <div>
                <dt class="ka-label">Preis</dt>
                <dd class="mt-0.5 text-slate-200"><%= chf(booking.total_price) %></dd>
              </div>
            </dl>

            <div class="mt-4 flex flex-wrap items-center gap-3">
              <span class="ka-chip"><%= booking.seat.label %></span>
              <%= link_to "QR-Code anzeigen", booking_path(booking),
                    class: "font-mono text-xs text-brand-400 underline transition hover:text-brand-300" %>
              <% if policy(booking).destroy? %>
                <%= button_to "Stornieren", booking_path(booking), method: :delete,
                      form: { data: { turbo_confirm: "Ticket wirklich stornieren?" } },
                      class: "font-mono text-xs text-slate-500 underline transition hover:text-brand-400" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
