<div class="mx-auto max-w-sm">
  <div class="ka-card p-8">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500">
        <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zm2 3v8h8V8H6zm10 0v2h2V8h-2zm0 4v2h2v-2h-2z"/>
        </svg>
      </span>
      <span class="font-display text-xl text-white">Kino<span class="text-brand-500">Arena</span></span>
    </div>

    <h1 class="mt-6 font-display text-lg text-white">Passwort vergessen</h1>
    <p class="mt-2 text-sm text-slate-400">
      Gib deine E-Mail-Adresse ein. Wir senden dir einen Link, mit dem du ein neues
      Passwort setzen kannst.
    </p>

    <%= form_with url: password_resets_path, method: :post, class: "mt-6 space-y-4" do |f| %>
      <div>
        <%= f.label :email_address, "E-Mail", class: "ka-label normal-case tracking-normal" %>
        <%= f.email_field :email_address, required: true, autofocus: true,
              placeholder: "anna@example.ch", class: "ka-input" %>
      </div>

      <%= f.submit "Link anfordern", class: "ka-btn-primary w-full py-3" %>
    <% end %>

    <p class="mt-5 text-center text-sm text-slate-400">
      <%= link_to "Zurück zur Anmeldung", login_path, class: "text-brand-500 transition hover:text-brand-400" %>
    </p>
  </div>
</div>
