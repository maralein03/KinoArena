<div class="mx-auto max-w-sm">
  <div class="ka-card p-8">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500">
        <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zm2 3v8h8V8H6zm10 0v2h2V8h-2zm0 4v2h2v-2h-2z"/>
        </svg>
      </span>
      <span class="font-display text-xl text-white">Kino<span class="text-brand-500">Arena</span></span>
    </div>

    <h1 class="mt-6 font-display text-lg text-white">Neues Passwort setzen</h1>
    <p class="mt-2 text-sm text-slate-400">Für <%= @user.email_address %></p>

    <div class="mt-6">
      <%= render "shared/errors", record: @user %>

      <%= form_with model: @user, url: password_reset_path(@token), method: :patch, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :password, "Neues Passwort", class: "ka-label normal-case tracking-normal" %>
          <%= f.password_field :password, required: true, autofocus: true,
                placeholder: "mindestens 8 Zeichen", class: "ka-input" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Passwort wiederholen", class: "ka-label normal-case tracking-normal" %>
          <%= f.password_field :password_confirmation, required: true, placeholder: "••••••••", class: "ka-input" %>
        </div>

        <%= f.submit "Passwort speichern", class: "ka-btn-primary w-full py-3" %>
      <% end %>
    </div>
  </div>
</div>
