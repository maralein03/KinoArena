<%# Wird per Turbo Stream ersetzt; der Zustand wird clientseitig aus den data-Werten abgeleitet. %>
<span id="seat-cell-<%= seat.id %>"
      data-seat-map-target="seat"
      data-seat-id="<%= seat.id %>"
      data-seat-label="<%= seat.label %>"
      data-booked="<%= booked %>"
      data-holder-id="<%= hold&.user_id %>"
      data-expires-at="<%= hold&.expires_at&.iso8601 %>">
  <% if booked %>
    <span class="flex h-7 w-7 items-center justify-center rounded-t-md rounded-b-sm
                 bg-ink-900 text-slate-700 ring-1 ring-inset ring-white/5"
          title="Platz <%= seat.label %> ist bereits gebucht">
      <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M4.3 4.3a1 1 0 011.4 0L10 8.6l4.3-4.3a1 1 0 111.4 1.4L11.4 10l4.3 4.3a1 1 0 01-1.4 1.4L10 11.4l-4.3 4.3a1 1 0 01-1.4-1.4L8.6 10 4.3 5.7a1 1 0 010-1.4z"/>
      </svg>
    </span>
  <% else %>
    <button type="button"
            data-action="seat-map#toggle"
            data-seat-map-target="button"
            class="flex h-7 w-7 items-center justify-center rounded-t-md rounded-b-sm transition">
      <span class="sr-only">Platz <%= seat.label %></span>
      <svg class="hidden h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M10 2a3 3 0 00-3 3v2H6a1 1 0 00-1 1v8a1 1 0 001 1h8a1 1 0 001-1V8a1 1 0 00-1-1h-1V5a3 3 0 00-3-3zm-1 5V5a1 1 0 112 0v2H9z"/>
      </svg>
    </button>
    <input type="checkbox" name="seat_ids[]" value="<%= seat.id %>" id="seat_<%= seat.id %>"
           class="sr-only" tabindex="-1" aria-hidden="true">
  <% end %>
</span>
