<div class="mx-auto max-w-4xl">
  <div class="text-center">
    <h1 class="text-4xl"><%= @showtime.movie.title %></h1>
    <p class="ka-label mt-2">
      <%= showtime_date(@showtime.start_time) %> &middot;
      <%= @showtime.start_time.strftime("%H:%M") %> &middot;
      <%= @showtime.auditorium.name %>
    </p>
  </div>

  <div class="mt-12">
    <div class="mx-auto h-2 w-3/4 rounded-full bg-brand-500 shadow-[0_0_60px_20px_rgba(232,17,45,0.25)]"></div>
    <p class="ka-label mt-3 text-center">Leinwand</p>
  </div>

  <% unless logged_in? %>
    <p class="mt-8 rounded-lg border border-gold-400/30 bg-gold-400/10 px-4 py-3 text-center text-sm text-gold-400">
      <%= link_to "Melde dich an", login_path, class: "font-medium underline" %>, um Tickets zu buchen.
    </p>
  <% end %>

  <%= form_with url: bookings_path, method: :post,
        data: { controller: "seat-map", seat_map_price_value: @showtime.price.to_f } do |f| %>
    <%= hidden_field_tag :showtime_id, @showtime.id %>

    <div class="mt-10 overflow-x-auto">
      <div class="mx-auto w-fit space-y-2">
        <% @rows.each do |row, seats| %>
          <div class="flex items-center gap-3">
            <span class="w-4 font-mono text-xs text-slate-500"><%= row %></span>

            <div class="flex gap-1.5">
              <% seats.each do |seat| %>
                <% if @booked_seat_ids.include?(seat.id) %>
                  <span class="h-7 w-7 rounded-t-md rounded-b-sm bg-ink-700/50 ring-1 ring-inset ring-white/5"
                        title="Platz <%= seat.label %> ist belegt"></span>
                <% else %>
                  <label class="group relative h-7 w-7 cursor-pointer rounded-t-md rounded-b-sm bg-ink-600
                                ring-1 ring-inset ring-white/10 transition
                                hover:bg-ink-700 hover:ring-brand-500/50
                                has-[:checked]:bg-brand-500 has-[:checked]:ring-brand-500"
                         title="Platz <%= seat.label %>">
                    <%= check_box_tag "seat_ids[]", seat.id, false,
                          disabled: !logged_in?,
                          class: "sr-only",
                          data: { seat_map_target: "seat", label: seat.label, action: "change->seat-map#update" } %>
                  </label>
                <% end %>
              <% end %>
            </div>

            <span class="w-4 font-mono text-xs text-slate-500"><%= row %></span>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-1">
          <span class="w-4"></span>
          <div class="flex gap-1.5">
            <% @seat_numbers.each do |number| %>
              <span class="w-7 text-center font-mono text-[10px] text-slate-600"><%= number %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-center gap-6 text-xs text-slate-400">
      <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 rounded-sm bg-ink-600 ring-1 ring-inset ring-white/10"></span> Frei</span>
      <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 rounded-sm bg-brand-500"></span> Ausgewählt</span>
      <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 rounded-sm bg-ink-700/50 ring-1 ring-inset ring-white/5"></span> Belegt</span>
    </div>

    <div class="ka-card mt-10 p-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="ka-label">Ausgewählte Plätze</p>
          <div class="mt-2 flex flex-wrap gap-1.5" data-seat-map-target="summary"></div>
        </div>

        <div class="text-right">
          <p class="font-display text-3xl text-gold-400" data-seat-map-target="total">CHF 0.00</p>
          <p class="mt-1 font-mono text-xs text-slate-500" data-seat-map-target="count"></p>
        </div>
      </div>

      <button type="submit"
              <%= "disabled" unless logged_in? %>
              data-seat-map-target="submit"
              class="ka-btn-primary mt-5 w-full py-3.5 text-base">
        Bitte Sitzplätze wählen
      </button>
    </div>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to "← Zurück zum Film", movie_path(@showtime.movie), class: "ka-label transition hover:text-white" %>
  </p>
</div>
