<%= turbo_stream_from SeatBroadcast.stream_name(@showtime) %>

<div class="mx-auto max-w-4xl"
     data-controller="seat-map"
     data-seat-map-price-value="<%= @showtime.price.to_f %>"
     data-seat-map-hold-url-value="<%= showtime_seat_holds_path(@showtime) %>"
     data-seat-map-logged-in-value="<%= logged_in? %>">
  <div class="text-center">
    <h1 class="text-4xl"><%= @showtime.movie.title %></h1>
    <p class="ka-label mt-2">
      <%= showtime_date(@showtime.start_time) %> &middot;
      <%= @showtime.start_time.strftime("%H:%M") %> &middot;
      <%= @showtime.auditorium.name %>
    </p>
  </div>

  <div class="mt-12">
    <div class="mx-auto h-2 w-3/4 rounded-full bg-brand-500 shadow-[0_0_60px_20px_rgba(232,17,45,0.25)]"></div>
    <p class="ka-label mt-3 text-center">Leinwand</p>
  </div>

  <% unless logged_in? %>
    <p class="mt-8 rounded-lg border border-gold-400/30 bg-gold-400/10 px-4 py-3 text-center text-sm text-gold-400">
      <%= link_to "Melde dich an", login_path, class: "font-medium underline" %>, um Tickets zu buchen.
    </p>
  <% end %>

  <div data-seat-map-target="notice" class="mt-6 hidden rounded-lg border border-brand-500/40 bg-brand-500/10 px-4 py-3 text-center text-sm text-brand-300"></div>

  <%= form_with url: bookings_path, method: :post do |f| %>
    <%= hidden_field_tag :showtime_id, @showtime.id %>

    <div class="mt-10 overflow-x-auto">
      <div class="mx-auto w-fit space-y-2">
        <% @rows.each do |row, seats| %>
          <div class="flex items-center gap-3">
            <span class="w-4 font-mono text-xs text-slate-500"><%= row %></span>

            <div class="flex gap-1.5">
              <% seats.each do |seat| %>
                <%= render "showtimes/seat",
                      seat: seat,
                      booked: @booked_seat_ids.include?(seat.id),
                      hold: @holds_by_seat_id[seat.id] %>
              <% end %>
            </div>

            <span class="w-4 font-mono text-xs text-slate-500"><%= row %></span>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-1">
          <span class="w-4"></span>
          <div class="flex gap-1.5">
            <% @seat_numbers.each do |number| %>
              <span class="w-7 text-center font-mono text-[10px] text-slate-600"><%= number %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-5 text-xs text-slate-400">
      <span class="flex items-center gap-2">
        <span class="h-3.5 w-3.5 rounded-sm bg-slate-600 ring-1 ring-inset ring-white/20"></span> Frei
      </span>
      <span class="flex items-center gap-2">
        <span class="h-3.5 w-3.5 rounded-sm bg-brand-500"></span> Deine Auswahl
      </span>
      <span class="flex items-center gap-2">
        <span class="h-3.5 w-3.5 rounded-sm bg-gold-400"></span> Wird gerade reserviert
      </span>
      <span class="flex items-center gap-2">
        <span class="flex h-3.5 w-3.5 items-center justify-center rounded-sm bg-ink-900 ring-1 ring-inset ring-white/5">
          <svg class="h-2 w-2 text-slate-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M4.3 4.3a1 1 0 011.4 0L10 8.6l4.3-4.3a1 1 0 111.4 1.4L11.4 10l4.3 4.3a1 1 0 01-1.4 1.4L10 11.4l-4.3 4.3a1 1 0 01-1.4-1.4L8.6 10 4.3 5.7a1 1 0 010-1.4z"/>
          </svg>
        </span> Bereits gebucht
      </span>
    </div>

    <div class="ka-card mt-10 p-5">
      <div data-seat-map-target="timer"
           class="mb-4 hidden items-center gap-3 rounded-lg border border-gold-400/30 bg-gold-400/10 px-4 py-3">
        <svg class="h-5 w-5 text-gold-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.4.8l2.5 1.9a1 1 0 101.2-1.6L11 9.5V6z" clip-rule="evenodd"/>
        </svg>
        <div>
          <p class="ka-label">Plätze reserviert für</p>
          <p class="font-mono text-xl text-gold-400" data-seat-map-target="countdown">05:00</p>
        </div>
      </div>

      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="ka-label">Ausgewählte Plätze</p>
          <div class="mt-2 flex flex-wrap gap-1.5" data-seat-map-target="summary"></div>
        </div>

        <div class="text-right">
          <p class="font-display text-3xl text-gold-400" data-seat-map-target="total">CHF 0.00</p>
          <p class="mt-1 font-mono text-xs text-slate-500" data-seat-map-target="count"></p>
        </div>
      </div>

      <button type="submit"
              id="submit-booking"
              <%= "disabled" unless logged_in? %>
              data-seat-map-target="submit"
              class="ka-btn-primary mt-5 w-full py-3.5 text-base">
        Bitte Sitzplätze wählen
      </button>
    </div>
  <% end %>

  <p class="mt-6 text-center">
    <%= link_to "← Zurück zum Film", movie_path(@showtime.movie), class: "ka-label transition hover:text-white" %>
  </p>
</div>
