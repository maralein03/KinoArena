<div class="max-w-5xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Aktuelles Programm</h1>

  <% if @showtimes.empty? %>
    <p class="text-gray-600">Aktuell sind keine Vorstellungen geplant.</p>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @showtimes.each do |showtime| %>
        <div class="border rounded-lg p-5 shadow-sm bg-white flex flex-col">
          <h2 class="text-2xl font-bold text-indigo-900 mb-2"><%= showtime.movie.title %></h2>
          <p class="text-gray-600 mb-4 flex-grow"><%= showtime.movie.description %></p>

          <div class="text-sm text-gray-500 space-y-1 mb-4">
            <p><strong>Saal:</strong> <%= showtime.auditorium.name %></p>
            <p><strong>Dauer:</strong> <%= showtime.movie.duration_minutes %> Min.</p>
            <p><strong>Zeit:</strong> <%= showtime.start_time.strftime("%d.%m.%Y %H:%M") %> Uhr</p>
            <p><strong>Preis:</strong> CHF <%= sprintf("%.2f", showtime.price) %></p>
          </div>

          <%= link_to "Sitzplaetze waehlen", showtime_path(showtime),
                class: "block text-center bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
