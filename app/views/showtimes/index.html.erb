<% content_for :hero do %>
  <section class="relative overflow-hidden border-b border-white/5">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-500/25 via-ink-950 to-gold-400/10"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-20">
      <p class="ka-label text-brand-400">Spielplan &middot; <%= showtime_date(Date.current).upcase %></p>
      <h1 class="mt-4 max-w-2xl text-5xl leading-tight md:text-6xl">
        Was läuft<br>
        <span class="text-brand-500">heute Abend?</span>
      </h1>
      <p class="mt-5 text-slate-400">
        <%= pluralize(@showtimes.size, "Vorstellung", plural: "Vorstellungen") %> im Programm
        &middot; Echtzeit-Verfügbarkeit &middot; Sofort-Buchung
      </p>
    </div>
  </section>
<% end %>

<% if @movies.empty? %>
  <div class="ka-card p-12 text-center">
    <p class="text-slate-400">Aktuell sind keine Vorstellungen geplant.</p>
  </div>
<% else %>
  <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
    <% @movies.each do |movie| %>
      <%= link_to movie_path(movie), class: "group block" do %>
        <div class="relative aspect-[2/3] overflow-hidden rounded-xl border border-white/10 bg-ink-800">
          <% if movie.poster_url.present? %>
            <%= image_tag movie.poster_url, alt: movie.title, loading: "lazy",
                  class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>
          <% else %>
            <div class="flex h-full items-center justify-center p-4 text-center">
              <span class="font-display text-lg text-slate-600"><%= movie.title %></span>
            </div>
          <% end %>

          <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-transparent to-transparent opacity-80"></div>

          <span class="absolute right-2 top-2 rounded-md bg-ink-950/70 px-2 py-0.5 font-mono text-xs text-slate-300">
            <%= movie.duration_label %>
          </span>
        </div>

        <h2 class="mt-3 text-base leading-snug transition group-hover:text-brand-400"><%= movie.title %></h2>
        <p class="ka-label mt-1 normal-case tracking-normal">
          <%= pluralize(@showtime_counts[movie.id].to_i, "Vorstellung", plural: "Vorstellungen") %>
        </p>
      <% end %>
    <% end %>
  </div>
<% end %>
