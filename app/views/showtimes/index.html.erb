<div class="max-w-4xl mx-auto mt-8 p-4">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">KinoArena – Aktuelles Programm</h1>
    
    <div>
      <% if logged_in? %>
        <span class="mr-4 text-gray-600">Angemeldet als: <strong><%= current_user.email_address %></strong></span>
        <%= link_to "Profil", user_path(current_user), class: "text-indigo-600 hover:underline mr-4" %>
        <% if current_user.admin? %>
          <%= link_to "Benutzerverwaltung", users_path, class: "text-indigo-600 hover:underline mr-4" %>
        <% end %>
        <%= link_to "Abmelden", logout_path, data: { turbo_method: :delete }, class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600" %>
      <% else %>
        <%= link_to "Anmelden", login_path, class: "bg-indigo-600 text-white px-3 py-1 rounded hover:bg-indigo-700 mr-2" %>
        <%= link_to "Registrieren", signup_path, class: "bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% @showtimes.each do |showtime| %>
      <div class="border rounded-lg p-5 shadow-sm bg-white">
        <h2 class="text-2xl font-bold text-indigo-900 mb-2"><%= showtime.movie.title %></h2>
        <p class="text-gray-600 mb-4"><%= showtime.movie.description %></p>
        <div class="text-sm text-gray-500 mb-4">
          <p><strong>Saal:</strong> <%= showtime.auditorium.name %></p>
          <p><strong>Dauer:</strong> <%= showtime.movie.duration_minutes %> Min.</p>
          <p><strong>Zeit:</strong> <%= showtime.start_time.strftime("%d.%m.%Y um %H:%M Uhr") %></p>
          <p><strong>Preis:</strong> CHF <%= sprintf('%.2f', showtime.price) %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>