<% content_for :hero do %>
  <section class="relative overflow-hidden border-b border-white/5">
    <% if @movie.poster_url.present? %>
      <%= image_tag @movie.poster_url, alt: "", aria: { hidden: true },
            class: "absolute inset-0 h-full w-full object-cover opacity-25 blur-sm" %>
    <% end %>
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/80 to-ink-950/40"></div>

    <div class="relative mx-auto flex w-full max-w-6xl items-end gap-6 px-5 pb-8 pt-14">
      <% if @movie.poster_url.present? %>
        <%= image_tag @movie.poster_url, alt: @movie.title,
              class: "hidden h-44 w-28 shrink-0 rounded-lg border border-white/10 object-cover shadow-2xl sm:block" %>
      <% end %>

      <div>
        <div class="flex items-center gap-2">
          <span class="ka-chip"><%= @movie.duration_label %></span>
        </div>
        <h1 class="mt-3 text-4xl md:text-5xl"><%= @movie.title %></h1>
      </div>
    </div>
  </section>
<% end %>

<%= link_to "← Zurück zum Programm", root_path, class: "ka-label transition hover:text-white" %>

<div class="mt-8 grid gap-10 lg:grid-cols-[1fr_400px]">
  <section>
    <h2 class="text-2xl">Handlung</h2>
    <div class="mt-2 h-0.5 w-12 bg-brand-500"></div>
    <p class="mt-5 leading-relaxed text-slate-400"><%= @movie.description %></p>
  </section>

  <section>
    <h2 class="text-2xl">Vorstellungen</h2>
    <div class="mt-2 h-0.5 w-12 bg-brand-500"></div>

    <% if @showtimes_by_date.empty? %>
      <p class="mt-5 text-sm text-slate-500">Für diesen Film sind derzeit keine Vorstellungen geplant.</p>
    <% end %>

    <% @showtimes_by_date.each do |date, showtimes| %>
      <p class="ka-label mt-6"><%= showtime_date(date) %></p>

      <div class="mt-3 space-y-3">
        <% showtimes.each do |showtime| %>
          <% free = showtime.available_seats.count %>
          <% total = showtime.auditorium.seats.count %>
          <%= link_to showtime_path(showtime),
                class: "ka-card block p-4 transition hover:border-brand-500/50" do %>
            <div class="flex items-baseline justify-between">
              <span class="font-mono text-2xl text-white"><%= showtime.start_time.strftime("%H:%M") %></span>
              <span class="font-mono text-sm text-gold-400"><%= chf(showtime.price) %></span>
            </div>
            <p class="mt-1 text-sm text-slate-400"><%= showtime.auditorium.name %></p>

            <div class="mt-3 flex items-center gap-3">
              <div class="h-1 flex-1 overflow-hidden rounded-full bg-ink-600">
                <div class="h-full <%= free.zero? ? 'bg-brand-500' : 'bg-emerald-500' %>"
                     style="width: <%= total.zero? ? 0 : ((total - free) * 100 / total) %>%"></div>
              </div>
              <span class="font-mono text-xs <%= free.zero? ? 'text-brand-400' : 'text-slate-400' %>">
                <%= free.zero? ? "ausverkauft" : "#{free} frei" %>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
